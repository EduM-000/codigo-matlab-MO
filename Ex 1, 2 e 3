O programa abaixo utiliza a formulação sugerida no enunciado — Rody Oldenhuis (2020) [17] / Dario Izzo (2015) [13] (documentando também a equivalência direta com McElreath et al. (2025) [15, 16]). Inclui a sub-rotina lambert_solver_local com controlo explícito da tolerância (tol) e do número máximo de iterações (Nmax) para executar os testes da secção 3.   Matlab% =========================================================================
% (a) Nome: teste_lambert_sec1a3.m
% (b) Número da versão actual: 1.0
% (c) Nomes dos autores: [Inserir Nomes e Números de Aluno do Grupo]
% (d) Data da primeira versão: 05/Nov/2026
% (e) Breve descrição:
%     Script de teste e validação do problema de Lambert correspondente às
%     secções 2.2.1, 2.2.2 e 2.2.3 do TPC-1 de Mecânica Orbital (x = 0.635):
%     1. Determina analiticamente os vectores r1, r2, v1, v2 e o tempo de
%        voo Delta_t da Órbita A pela solução Kepleriana.
%     2. Resolve o problema de Lambert (M = 0, sentido directo) e compara
%        v1,L e v2,L com as velocidades exactas.
%     3. Reconstrói (a, e, theta_1, theta_2) a partir de (r1, v1,L).
%     4. Verifica independentemente as velocidades usando a corda c, os
%        versores i_r1, i_r2, i_c e cot(alpha/2), cot(beta/2).
%     5. Resolve o problema inverso no tempo (de r2 para r1 em Delta_t).
%     6. Avalia a precisão numérica do solver para diferentes tolerâncias.
% (f) Lista de algoritmos utilizados e referências:
%     - Relações Keplerianas e equação de Lambert (corda e cotangentes):
%       [1] P. J. S. Gil, "Elementos de Mecânica Orbital", IST, 2015
%           (vs. 1.5.1, 2025-09-08).
%     - Lambert solver de referência:
%       [17] R. Oldenhuis, "Robust solver for Lambert's orbital-boundary
%            value problem", MATLAB Central File Exchange, v1.4, 2020.
%       [13] D. Izzo, "Revisiting Lambert's problem", Celestial Mechanics
%            and Dynamical Astronomy, 121(1):1-15, 2015.
%     - Alterações efectuadas relativamente ao algoritmo original:
%       Exposição dos argumentos de tolerância (tol) e número máximo de
%       iterações (Nmax) na sub-rotina lambert_solver_local para permitir
%       o estudo de convergência da pergunta 3.(b).
% (g) Intervalos de validade esperados e efectivamente testados:
%     - Esperados: Delta_t > 0, órbitas não degeneradas (r1 x r2 ~= 0),
%       0 < Delta_theta < 2*pi, M >= 0.
%     - Efectivamente testados: a_A = 9505 km, e_A = 0.227, theta_1 = 30 deg,
%       theta_2 = 72.7 deg, Delta_t = 781.57961630 s, M = 0,
%       tol em [1e-4, 1e-15].
% (h) Lista de inputs:
%     Parâmetro adimensional x = 0.635 e mu_Terra = 3.986e5 km^3/s^2.
% (i) Lista de outputs:
%     Impressão formatada na consola de r1, r2, v1, v2, Delta_t, v1_L, v2_L,
%     elementos orbitais reconstruídos, velocidades pela fórmula das
%     cotangentes, solução inversa no tempo e tabela de erros vs. tol.
% (j) Lista de dependências:
%     Ficheiro autónomo (inclui as funções locais lambert_solver_local,
%     tof_izzo e rv2oe_planar).
% (k) Versão do software / ambiente de desenvolvimento e teste:
%     MATLAB R2024b / R2025a
% (l) Lista de alterações efectuadas e respectivas datas:
%     - 05/Nov/2026 (v1.0): Versão inicial desenvolvida para o TPC-1.
%     [Espaço reservado para registo de alterações futuras]
% =========================================================================

clear; clc;
format long;

% Parâmetros exactos do grupo e do enunciado
x    = 0.635;
mu_E = 3.986e5; % km^3/s^2

fprintf('======================================================================\n');
fprintf('  TPC-1 MECÂNICA ORBITAL (2026/27) - PERGUNTA 2 (Sec. 1 a 3, x = %.3f)\n', x);
fprintf('======================================================================\n\n');

%% ------------------------------------------------------------------------
%  PERGUNTA 2.(a): Solução analítica conhecida (Órbita A)
%  ------------------------------------------------------------------------
aA      = 7600 + 3000 * x;      % 9505 km
eA      = 0.10 + 0.20 * x;      % 0.227
th1_deg = 30.0;                 % graus
th2_deg = 60.0 + 20.0 * x;      % 72.7 graus

% Conversão para radianos antes de usar funções trigonométricas
th1 = th1_deg * pi / 180;
th2 = th2_deg * pi / 180;

% Parâmetro p (semilatus rectum) e factor de velocidade
pA    = aA * (1 - eA^2);
v_fac = sqrt(mu_E / pA);

% Módulos dos raios r1 e r2
r1_mag = pA / (1 + eA * cos(th1));
r2_mag = pA / (1 + eA * cos(th2));

% Vectores de posição r1 e r2 (plano xy, periápside no semi-eixo +x)
r1 = [r1_mag * cos(th1); r1_mag * sin(th1); 0];
r2 = [r2_mag * cos(th2); r2_mag * sin(th2); 0];

% Vectores de velocidade v1 e v2 no referencial perifocal/cartesiano
v1 = v_fac * [-sin(th1); eA + cos(th1); 0];
v2 = v_fac * [-sin(th2); eA + cos(th2); 0];

% Anomalias excêntricas E1 e E2 e anomalias médias M1 e M2
k_e = sqrt((1 - eA) / (1 + eA));
E1  = 2 * atan(k_e * tan(th1 / 2));
E2  = 2 * atan(k_e * tan(th2 / 2));

M1 = E1 - eA * sin(E1);
M2 = E2 - eA * sin(E2);

% Movimento médio n_A e tempo de voo Delta_t
nA = sqrt(mu_E / aA^3);
dt = (M2 - M1) / nA;

fprintf('--- PERGUNTA 2.(a): Solução Analítica da Órbita A ---\n');
fprintf('a_A     = %.6f km | e_A = %.6f | p_A = %.8f km\n', aA, eA, pA);
fprintf('theta_1 = %.4f deg (%.12f rad)\n', th1_deg, th1);
fprintf('theta_2 = %.4f deg (%.12f rad)\n', th2_deg, th2);
fprintf('r_1     = [ %16.8f ; %16.8f ; %8.4f ] km   (|r_1| = %.8f km)\n', r1(1), r1(2), r1(3), r1_mag);
fprintf('r_2     = [ %16.8f ; %16.8f ; %8.4f ] km   (|r_2| = %.8f km)\n', r2(1), r2(2), r2(3), r2_mag);
fprintf('v_1     = [ %16.10f ; %16.10f ; %8.4f ] km/s (|v_1| = %.10f km/s)\n', v1(1), v1(2), v1(3), norm(v1));
fprintf('v_2     = [ %16.10f ; %16.10f ; %8.4f ] km/s (|v_2| = %.10f km/s)\n', v2(1), v2(2), v2(3), norm(v2));
fprintf('E_1     = %.12f rad | M_1 = %.12f rad\n', E1, M1);
fprintf('E_2     = %.12f rad | M_2 = %.12f rad\n', E2, M2);
fprintf('Delta_t = %.10f s\n\n', dt);

%% ------------------------------------------------------------------------
%  PERGUNTA 2.(b): Resolução com o Lambert solver (M = 0, sentido directo)
%  ------------------------------------------------------------------------
tol_padrao  = 1e-12;
Nmax_padrao = 100;

[v1_L, v2_L, ~] = lambert_solver_local(r1, r2, dt, mu_E, 0, 'prograde', 'left', tol_padrao, Nmax_padrao);

fprintf('--- PERGUNTA 2.(b): Comparação com o Lambert Solver (M = 0, directo) ---\n');
fprintf('v_1,L   = [ %16.10f ; %16.10f ; %8.4f ] km/s\n', v1_L(1), v1_L(2), v1_L(3));
fprintf('v_2,L   = [ %16.10f ; %16.10f ; %8.4f ] km/s\n', v2_L(1), v2_L(2), v2_L(3));
fprintf('Erro ||v_1,L - v_1|| = %.6e km/s\n', norm(v1_L - v1));
fprintf('Erro ||v_2,L - v_2|| = %.6e km/s\n\n', norm(v2_L - v2));

%% ------------------------------------------------------------------------
%  PERGUNTA 2.(c): Elementos orbitais a partir de (r1, v1_L)
%  ------------------------------------------------------------------------
[a_L, e_L, th1_L, th2_L] = rv2oe_planar(r1, v1_L, r2, mu_E);

fprintf('--- PERGUNTA 2.(c): Elementos Orbitais Reconstruídos ---\n');
fprintf('a_L       = %.10f km  | |a_L - a_A|         = %.6e km\n', a_L, abs(a_L - aA));
fprintf('e_L       = %.12f     | |e_L - e_A|         = %.6e\n', e_L, abs(e_L - eA));
fprintf('theta_1,L = %.12f rad (%.8f deg) | |d_th1| = %.6e rad\n', th1_L, th1_L*180/pi, abs(th1_L - th1));
fprintf('theta_2,L = %.12f rad (%.8f deg) | |d_th2| = %.6e rad\n\n', th2_L, th2_L*180/pi, abs(th2_L - th2));

%% ------------------------------------------------------------------------
%  PERGUNTA 2.(d): Verificação independente com corda, versores e cotangentes
%  ------------------------------------------------------------------------
c_vec = r2 - r1;
c_mag = norm(c_vec);
s_sem = 0.5 * (r1_mag + r2_mag + c_mag);

i_r1 = r1 / r1_mag;
i_r2 = r2 / r2_mag;
i_c  = c_vec / c_mag;

alpha_L = 2 * asin(sqrt(s_sem / (2 * a_L)));
beta_L  = 2 * asin(sqrt((s_sem - c_mag) / (2 * a_L)));

A_cot = sqrt(mu_E / (4 * a_L)) * cot(alpha_L / 2);
B_cot = sqrt(mu_E / (4 * a_L)) * cot(beta_L / 2);

v1_cot = (B_cot + A_cot) * i_c + (B_cot - A_cot) * i_r1;
v2_cot = (B_cot + A_cot) * i_c - (B_cot - A_cot) * i_r2;

fprintf('--- PERGUNTA 2.(d): Verificação por Corda e cot(alpha/2), cot(beta/2) ---\n');
fprintf('c       = %.8f km | s = %.8f km\n', c_mag, s_sem);
fprintf('alpha   = %.12f rad | cot(alpha/2) = %.12f\n', alpha_L, cot(alpha_L/2));
fprintf('beta    = %.12f rad | cot(beta/2)  = %.12f\n', beta_L, cot(beta_L/2));
fprintf('A       = %.10f km/s | B = %.10f km/s\n', A_cot, B_cot);
fprintf('v_1,cot = [ %16.10f ; %16.10f ; %8.4f ] km/s\n', v1_cot(1), v1_cot(2), v1_cot(3));
fprintf('v_2,cot = [ %16.10f ; %16.10f ; %8.4f ] km/s\n', v2_cot(1), v2_cot(2), v2_cot(3));
fprintf('Diferença ||v_1,cot - v_1,L|| = %.6e km/s\n', norm(v1_cot - v1_L));
fprintf('Diferença ||v_2,cot - v_2,L|| = %.6e km/s\n\n', norm(v2_cot - v2_L));

%% ------------------------------------------------------------------------
%  PERGUNTA 2.(e): Problema inverso no tempo (troca de r1 e r2, mesmo Delta_t)
%  ------------------------------------------------------------------------
[v_ini_retr, v_fim_retr, ~] = lambert_solver_local(r2, r1, dt, mu_E, 0, 'retrograde', 'left', tol_padrao, Nmax_padrao);
[v_ini_prog, v_fim_prog, ~] = lambert_solver_local(r2, r1, dt, mu_E, 0, 'prograde',   'left', tol_padrao, Nmax_padrao);

fprintf('--- PERGUNTA 2.(e): Problema Inverso no Tempo (de r_2 para r_1 em Delta_t) ---\n');
fprintf('1) Movimento ao longo da mesma elipse em sentido inverso (retrógrado, h_z < 0):\n');
fprintf('   v_ini,inv (em r_2) = [ %16.10f ; %16.10f ; %8.4f ] km/s\n', v_ini_retr(1), v_ini_retr(2), v_ini_retr(3));
fprintf('   v_fim,inv (em r_1) = [ %16.10f ; %16.10f ; %8.4f ] km/s\n', v_fim_retr(1), v_fim_retr(2), v_fim_retr(3));
fprintf('   ||v_ini,inv - (-v_2,L)|| = %.6e km/s\n', norm(v_ini_retr + v2_L));
fprintf('   ||v_fim,inv - (-v_1,L)|| = %.6e km/s\n', norm(v_fim_retr + v1_L));
fprintf('2) Movimento forçando sentido directo (progrado, h_z > 0, arco longo 317.3 deg):\n');
fprintf('   v_ini,prog (em r_2) = [ %16.10f ; %16.10f ; %8.4f ] km/s\n', v_ini_prog(1), v_ini_prog(2), v_ini_prog(3));
fprintf('   v_fim,prog (em r_1) = [ %16.10f ; %16.10f ; %8.4f ] km/s\n\n', v_fim_prog(1), v_fim_prog(2), v_fim_prog(3));

%% ------------------------------------------------------------------------
%  PERGUNTA 3.(b): Precisão do solver para diferentes tolerâncias
%  ------------------------------------------------------------------------
tols_3b = [1e-4, 1e-6, 1e-9, 1e-12, 1e-14, 1e-15];

fprintf('--- PERGUNTA 3.(b): Comparação de Erros em Função da Tolerância ---\n');
fprintf('%-10s | %-6s | %-14s | %-14s | %-14s | %-14s\n', ...
        'Tolerancia', 'N_iter', '||dv_1|| (km/s)', '||dv_2|| (km/s)', '|da| (km)', '|de|');
fprintf('------------------------------------------------------------------------------------------\n');

for k = 1:length(tols_3b)
    tk = tols_3b(k);
    [v1_k, v2_k, nit_k] = lambert_solver_local(r1, r2, dt, mu_E, 0, 'prograde', 'left', tk, Nmax_padrao);
    [a_k, e_k, ~, ~]    = rv2oe_planar(r1, v1_k, r2, mu_E);
    fprintf('%-10.0e | %-6d | %-14.6e | %-14.6e | %-14.6e | %-14.6e\n', ...
            tk, nit_k, norm(v1_k - v1), norm(v2_k - v2), abs(a_k - aA), abs(e_k - eA));
end
fprintf('\n');

%% ========================================================================
%  SUB-ROTINAS AUXILIARES
%  ========================================================================

function [a, e_mag, th1, th2] = rv2oe_planar(r1, v1, r2, mu)
    r1_n = norm(r1);
    v1_n = norm(v1);
    energia = 0.5 * v1_n^2 - mu / r1_n;
    a = -mu / (2 * energia);
    
    h_vec = cross(r1, v1);
    e_vec = cross(v1, h_vec) / mu - r1 / r1_n;
    e_mag = norm(e_vec);
    
    u_e = e_vec / e_mag;
    u_p = cross(h_vec / norm(h_vec), u_e);
    
    th1 = atan2(dot(r1, u_p), dot(r1, u_e));
    if th1 < 0, th1 = th1 + 2*pi; end
    
    th2 = atan2(dot(r2, u_p), dot(r2, u_e));
    if th2 < 0, th2 = th2 + 2*pi; end
end

function [v1, v2, n_iter] = lambert_solver_local(r1, r2, dt, mu, M_rev, sentido, ramo, tol, Nmax)
    r1_n  = norm(r1);
    r2_n  = norm(r2);
    c_vec = r2 - r1;
    c_n   = norm(c_vec);
    s     = 0.5 * (r1_n + r2_n + c_n);
    
    ir1 = r1 / r1_n;
    ir2 = r2 / r2_n;
    ih_geom = cross(ir1, ir2);
    
    cos_dth = dot(ir1, ir2);
    sin_dth = norm(ih_geom);
    if strcmpi(sentido, 'prograde')
        if ih_geom(3) < 0, sin_dth = -sin_dth; end
        ih = ih_geom / norm(ih_geom);
        if ih(3) < 0, ih = -ih; end
    else
        if ih_geom(3) > 0, sin_dth = -sin_dth; end
        ih = ih_geom / norm(ih_geom);
        if ih(3) > 0, ih = -ih; end
    end
    dth = atan2(sin_dth, cos_dth);
    if dth < 0, dth = dth + 2*pi; end
    
    lam2 = 1 - c_n / s;
    lam  = sqrt(lam2);
    if dth > pi, lam = -lam; end
    
    T   = sqrt(2 * mu / s^3) * dt;
    T00 = acos(lam) + lam * sqrt(1 - lam2);
    T0  = T00 + M_rev * pi;
    T1  = 2/3 * (1 - lam^3);
    
    if M_rev == 0
        if T >= T0
            x_k = (T0 / T)^(2/3) - 1;
        elseif T < T1
            x_k = 5/2 * T1 * (T1 - T) / (T * (1 - lam^5)) + 1;
        else
            x_k = (T0 / T)^(log2(T1 / T0)) - 1;
        end
    else
        if strcmpi(ramo, 'left')
            x_k = -0.5;
        else
            x_k = 0.5;
        end
    end
    
    n_iter = 0;
    for k = 1:Nmax
        n_iter = k;
        [tof_k, dT] = tof_izzo(x_k, lam, M_rev);
        f_k  = tof_k - T;
        dx   = f_k / dT;
        x_k1 = x_k - dx;
        if abs(dx) < tol && abs(f_k) < tol
            x_k = x_k1;
            break;
        end
        x_k = x_k1;
    end
    
    gamma = sqrt(mu * s / 2);
    rho   = (r1_n - r2_n) / c_n;
    sigma = sqrt(1 - rho^2);
    y     = sqrt(1 - lam2 * (1 - x_k^2));
    
    vr1 = gamma * ((lam * y - x_k) - rho * (lam * y + x_k)) / r1_n;
    vr2 = -gamma * ((lam * y - x_k) + rho * (lam * y + x_k)) / r2_n;
    vt1 = gamma * sigma * (y + lam * x_k) / r1_n;
    vt2 = gamma * sigma * (y + lam * x_k) / r2_n;
    
    it1 = cross(ih, ir1);
    it2 = cross(ih, ir2);
    
    v1 = vr1 * ir1 + vt1 * it1;
    v2 = vr2 * ir2 + vt2 * it2;
end

function [T_val, dT] = tof_izzo(x, lam, M_rev)
    lam2 = lam^2;
    a_ad = 1 / (1 - x^2);
    y    = sqrt(1 - lam2 * (1 - x^2));
    if a_ad > 0
        alfa  = 2 * acos(x);
        beta  = 2 * asin(sqrt(lam2 / a_ad));
        if lam < 0, beta = -beta; end
        T_val = 0.5 * a_ad * sqrt(a_ad) * ((alfa - sin(alfa)) - (beta - sin(beta)) + 2 * pi * M_rev);
    else
        alfa  = 2 * acosh(x);
        beta  = 2 * asinh(sqrt(-lam2 / a_ad));
        if lam < 0, beta = -beta; end
        T_val = -0.5 * a_ad * sqrt(-a_ad) * ((sinh(alfa) - alfa) - (sinh(beta) - beta));
    end
    dT = (3 * T_val * x - 2 + 2 * lam^3 * x / y) / (1 - x^2);
end
