eB = 0.80 + 0.15 * CHI
aB = rpA / (1 - eB)          # (12): mesma periapside, rp = aB(1-eB)
 
 
# ----------------------------- KEPLER -------------------------------------
def kepler_newton(e, M, tol=1e-14, nmax=100):
    M = np.mod(M, 2 * np.pi)
    E = M if M > np.pi else (min(M + e, np.pi) if M <= np.pi else M)
    for _ in range(nmax):
        f = E - e * np.sin(E) - M
        dE = f / (1 - e * np.cos(E))
        E -= dE
        if abs(dE) < tol and abs(E - e * np.sin(E) - M) < tol:
            break
    return E
 
 
def theta_to_M(theta, e):
    E = 2 * np.arctan2(np.sqrt(1 - e) * np.sin(theta / 2), np.sqrt(1 + e) * np.cos(theta / 2))
    return np.mod(E - e * np.sin(E), 2 * np.pi)
 
 
def state_at(a, e, theta):
    p = a * (1 - e**2)
    r = p / (1 + e * np.cos(theta))
    rv = r * np.array([np.cos(theta), np.sin(theta), 0.0])
    vv = np.sqrt(MU / p) * np.array([-np.sin(theta), e + np.cos(theta), 0.0])
    return rv, vv
 
 
def tof_kepler(a, e, t1, t2):
    n = np.sqrt(MU / a**3)
    dM = np.mod(theta_to_M(t2, e) - theta_to_M(t1, e), 2 * np.pi)
    return dM / n
 
 
def elements(r, v):
    """a, e, true anomaly (rad) a partir de (r, v), plano xy, periapside em +x esperado."""
    rn, v2 = np.linalg.norm(r), v @ v
    a = 1 / (2 / rn - v2 / MU)
    h = np.cross(r, v)
    evec = np.cross(v, h) / MU - r / rn
    e = np.linalg.norm(evec)
    if e < 1e-12:
        return a, e, np.nan, evec
    nu = np.arctan2(np.cross(evec, r) @ h / np.linalg.norm(h), evec @ r)
    return a, e, np.mod(nu, 2 * np.pi), evec
 
 
def lambert(r1, r2, tof, M=0, prograde=True, low_path=True):
    return izzo2015(MU, r1, r2, tof, M=M, prograde=prograde, low_path=low_path,
                    maxiter=MAXITER, atol=ATOL, rtol=RTOL)
 
 
def fmt(v):
    return np.array2string(np.asarray(v), precision=9, suppress_small=False)
 
 
# ----------------------------- Q4 -----------------------------------------
def caso(a, e, nome):
    r1, v1 = state_at(a, e, th1)
    r2, v2 = state_at(a, e, th2)
    dt = tof_kepler(a, e, th1, th2)
    v1L, v2L = lambert(r1, r2, dt, M=0, prograde=True)
    aL, eL, nu1L, evec = elements(r1, v1L)
    _, _, nu2L, _ = elements(r2, v2L)
    print(f"\n=== {nome}: a={a:.9f} km, e={e:.9f} ===")
    print("r1 =", fmt(r1), " r2 =", fmt(r2))
    print("v1 =", fmt(v1), " v2 =", fmt(v2), " dt = %.9f s" % dt)
    print("v1L=", fmt(v1L), " v2L=", fmt(v2L))
    res = dict(
        dv1=np.linalg.norm(v1L - v1), dv2=np.linalg.norm(v2L - v2),
        da=abs(aL - a), de=abs(eL - e),
        dnu1=abs(nu1L - th1), dnu2=abs(nu2L - th2))
    for k, x in res.items():
        print(f"  erro {k:5s} = {x:.3e}")
    return res
 
 
